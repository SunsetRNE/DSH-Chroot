{
  "schema": 1,
  "_note": "版本闸门的唯一规格：所有实现（Python / POSIX sh / Node）都必须与这张表逐条一致。改规则 = 改这张表 + 改三份实现 + 跑 tools/check-gate.py。",
  "_why_this_file": "版本比较是整套方案里唯一写错会静默出错的地方：字符串比较在 0.2.1-rc.1 vs 0.2.0-rc.2 上给出相反答案，而错误不抛异常、不进日志。",
  "compare": [
    {
      "a": "0.2.1-rc.1",
      "b": "0.2.0-rc.2",
      "expect": 1,
      "why": "字典序会给出相反答案 —— 本项目的经典陷阱"
    },
    {
      "a": "0.2.0",
      "b": "0.2.0-rc.2",
      "expect": 1,
      "why": "final > 所有 rc"
    },
    {
      "a": "0.2.1-rc.1",
      "b": "0.2.0",
      "expect": 1,
      "why": "minor 抬升优先于 prerelease 后缀"
    },
    {
      "a": "0.2.0",
      "b": "0.2.1-rc.1",
      "expect": -1,
      "why": "同上，反向"
    },
    {
      "a": "0.2.0-rc.2",
      "b": "0.2.0-rc.2",
      "expect": 0,
      "why": "相等"
    },
    {
      "a": "0.2.0-rc.10",
      "b": "0.2.0-rc.9",
      "expect": 1,
      "why": "rc 序号按数值比，不按字典序"
    },
    {
      "a": "0.2.0-rc.2",
      "b": "0.2.0-rc.10",
      "expect": -1,
      "why": "同上反向"
    },
    {
      "a": "1.0.0-alpha",
      "b": "1.0.0-alpha.1",
      "expect": -1,
      "why": "前缀相同，段数多者更大"
    },
    {
      "a": "1.0.0-alpha.1",
      "b": "1.0.0-alpha.beta",
      "expect": -1,
      "why": "数字段 < 字母段"
    },
    {
      "a": "1.0.0-alpha.beta",
      "b": "1.0.0-beta",
      "expect": -1,
      "why": "字母段按 ASCII 字典序"
    },
    {
      "a": "1.0.0-beta",
      "b": "1.0.0-beta.2",
      "expect": -1,
      "why": "段数更多"
    },
    {
      "a": "1.0.0-beta.2",
      "b": "1.0.0-beta.11",
      "expect": -1,
      "why": "数值比较"
    },
    {
      "a": "1.0.0-beta.11",
      "b": "1.0.0-rc.1",
      "expect": -1,
      "why": "ascii 序 beta < rc"
    },
    {
      "a": "1.0.0-rc.1",
      "b": "1.0.0",
      "expect": -1,
      "why": "rc 小于 final"
    },
    {
      "a": "1.0.0+build.1",
      "b": "1.0.0",
      "expect": 0,
      "why": "build 元数据不参与比较"
    },
    {
      "a": "1.0.0+a",
      "b": "1.0.0+b",
      "expect": 0,
      "why": "同上"
    },
    {
      "a": "1.0.0-rc.1",
      "b": "1.0.0-rc.1+build.9",
      "expect": 0,
      "why": "同上（一侧带 build）"
    },
    {
      "a": "2.0.0",
      "b": "10.0.0",
      "expect": -1,
      "why": "数值比较，字典序会给出相反结果"
    },
    {
      "a": "0.9.9",
      "b": "1.0.0",
      "expect": -1,
      "why": "major 优先"
    },
    {
      "a": "20261017.1.0",
      "b": "20261016.99.99",
      "expect": 1,
      "why": "大数：不能靠 shell 整型溢出侥幸"
    },
    {
      "a": "1.0.0-1",
      "b": "1.0.0-2",
      "expect": -1,
      "why": "纯数字 prerelease"
    },
    {
      "a": "1.0.0-2",
      "b": "1.0.0-10",
      "expect": -1,
      "why": "数值比较"
    },
    {
      "a": "1.0.0-10",
      "b": "1.0.0-a",
      "expect": -1,
      "why": "数字段一律小于字母段"
    },
    {
      "a": "1.0.0-a",
      "b": "1.0.0-a0",
      "expect": -1,
      "why": "单段字典序（a < a0）"
    },
    {
      "a": "1.0.0-alpha",
      "b": "1.0.0-alpha.0",
      "expect": -1,
      "why": "段数决定，与最后一段的值无关"
    },
    {
      "a": "1.2.3",
      "b": "1.2.3-0",
      "expect": 1,
      "why": "final > prerelease（哪怕 prerelease 是 0）"
    },
    {
      "a": "0.0.0",
      "b": "0.0.0",
      "expect": 0,
      "why": "全零"
    }
  ],
  "chain": {
    "_note": "升序链：runner 断言每一对相邻项严格递增（覆盖整条发布通道，比零散用例更强）",
    "versions": [
      "0.1.0",
      "0.2.0-alpha.1",
      "0.2.0-alpha.beta",
      "0.2.0-beta",
      "0.2.0-beta.2",
      "0.2.0-beta.11",
      "0.2.0-rc.1",
      "0.2.0-rc.2",
      "0.2.0-rc.10",
      "0.2.0",
      "0.2.1-rc.1",
      "0.2.1-rc.2",
      "0.2.1",
      "0.3.0-rc.1",
      "1.0.0"
    ]
  },
  "check": [
    {
      "v": "",
      "expect": "invalid",
      "why": "空串"
    },
    {
      "v": " ",
      "expect": "invalid",
      "why": "空白（严格模式不做 trim）"
    },
    {
      "v": " 1.2.3",
      "expect": "invalid",
      "why": "前导空白"
    },
    {
      "v": "1.2.3 ",
      "expect": "invalid",
      "why": "尾随空白"
    },
    {
      "v": "1",
      "expect": "invalid",
      "why": "缺段"
    },
    {
      "v": "1.2",
      "expect": "invalid",
      "why": "缺段"
    },
    {
      "v": "1.2.3.4",
      "expect": "invalid",
      "why": "多段"
    },
    {
      "v": "v1.2.3",
      "expect": "invalid",
      "why": "不允许 v 前缀"
    },
    {
      "v": "-1.2.3",
      "expect": "invalid",
      "why": "缺主版本号"
    },
    {
      "v": "01.2.3",
      "expect": "invalid",
      "why": "核心数字不允许前导零"
    },
    {
      "v": "1.02.3",
      "expect": "invalid",
      "why": "同上"
    },
    {
      "v": "1.2.03",
      "expect": "invalid",
      "why": "同上"
    },
    {
      "v": "1.2.3-",
      "expect": "invalid",
      "why": "prerelease 为空"
    },
    {
      "v": "1.2.3+",
      "expect": "invalid",
      "why": "build 为空"
    },
    {
      "v": "1.2.3-01",
      "expect": "invalid",
      "why": "数字 prerelease 段不允许前导零"
    },
    {
      "v": "1.2.3-0.",
      "expect": "invalid",
      "why": "prerelease 尾随点"
    },
    {
      "v": "1.2.3..1",
      "expect": "invalid",
      "why": "空段"
    },
    {
      "v": "1.2.3-a_b",
      "expect": "invalid",
      "why": "下划线不在允许字符集"
    },
    {
      "v": "1.2.3-测试",
      "expect": "invalid",
      "why": "非 ASCII"
    },
    {
      "v": "1.2.3-a b",
      "expect": "invalid",
      "why": "空格"
    },
    {
      "v": "1.2.3+a..b",
      "expect": "invalid",
      "why": "build 空段"
    },
    {
      "v": "1.2.3+a+b",
      "expect": "invalid",
      "why": "多个 +"
    },
    {
      "v": "0.0.0",
      "expect": "ok",
      "why": "全零"
    },
    {
      "v": "1.2.3",
      "expect": "ok",
      "why": "基本形态"
    },
    {
      "v": "1.2.3-alpha",
      "expect": "ok",
      "why": ""
    },
    {
      "v": "1.2.3-alpha.1",
      "expect": "ok",
      "why": ""
    },
    {
      "v": "1.2.3-0.3.7",
      "expect": "ok",
      "why": "数字 prerelease 段（非前导零）"
    },
    {
      "v": "1.2.3-x.7.z.92",
      "expect": "ok",
      "why": "混合段"
    },
    {
      "v": "1.2.3+build",
      "expect": "ok",
      "why": "带 build"
    },
    {
      "v": "1.2.3-rc.1+build.5",
      "expect": "ok",
      "why": "两者都带"
    },
    {
      "v": "1.2.3--",
      "expect": "ok",
      "why": "连字符是合法标识符字符"
    },
    {
      "v": "1.2.3-a-b",
      "expect": "ok",
      "why": "同上"
    },
    {
      "v": "1.2.3-rc.1-",
      "expect": "ok",
      "why": "1- 是字母数字段（含 -），不是纯数字段"
    },
    {
      "v": "10.20.30",
      "expect": "ok",
      "why": "多位数"
    },
    {
      "v": "0.2.0-rc.2",
      "expect": "ok",
      "why": "本项目当前基线"
    }
  ]
}
