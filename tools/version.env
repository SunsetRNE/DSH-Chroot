# ============================================================
# version.env —— 模块身份与模块版本（四位 version 的**前三位**）
# 生成方式: python3 tools/gen-version.py
# 生成物:   build/module.prop · build/manifest.json · build/apk-version.properties
# 规范见 docs/versioning.md
#
# 这里**不写** DSH 版本（ADR-025）：
#   第 4 位 + manifest.baked  <- baseline/bake-ledger.json（烘焙台账，只追加）
#   floor / recommended / node_floor <- baseline/dsh.env
# ============================================================

# --- 模块身份（2026-10-17 定稿；改 id 等于变成另一个模块，见 docs/versioning.md §8） ---
# 四个字符串各司其职：id = 目录名/CLI（永久）· name = 管理器卡片 · 仓库名 = updateJson URL
MODULE_ID=Zodiac-Quill-Saga
MODULE_NAME=DSH Chroot
AUTHOR=SunsetRNE
DESCRIPTION=DSH 的 Android root 模块：真 chroot（不是 proot）· 开机自启 + 版本闸门 + 局域网访问
UPDATE_JSON=https://raw.githubusercontent.com/SunsetRNE/DSH-Chroot/main/update.json

# --- 模块版本前三位: 大版本.功能变更新增.补丁 ---
# 第 4 位**不在这里**：它 = 烘焙台账的 seq（见 baseline/bake-ledger.json）
V_MAJOR=1
V_FEATURE=0
V_PATCH=2

# --- versionCode: 只等于"变更了多少次"（面向 Root 管理器），与 version 无推导关系 ---
VERSION_CODE=4

# --- 管理特性：留空即代表不接管任何内核特性（有真实实现才填，且要与模块 config 的 manage.*=true 成对） ---
MANAGED_FEATURES=
